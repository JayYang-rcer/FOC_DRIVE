ct\\\" value=\\\"LOCAL\\\" />\\r\\n      <updated>1773946022615</updated>\\r\\n    </task>\\r\\n    <option name=\\\"localTasksCounter\\\" value=\\\"33\\\" />\\r\\n    <servers />\\r\\n  </component>\\r\\n  <component name=\\\"TypeScriptGeneratedFilesManager\\\">\\r\\n    <option name=\\\"version\\\" value=\\\"3\\\" />\\r\\n  </component>\\r\\n  <component name=\\\"VCPKGProject\\\">\\r\\n    <isAutomaticCheckingOnLaunch value=\\\"false\\\" />\\r\\n    <isAutomaticFoundErrors value=\\\"true\\\" />\\r\\n    <isAutomaticReloadCMake value=\\\"true\\\" />\\r\\n  </component>\\r\\n  <component name=\\\"Vcs.Log.Tabs.Properties\\\">\\r\\n    <option name=\\\"TAB_STATES\\\">\\r\\n      <map>\\r\\n        <entry key=\\\"MAIN\\\">\\r\\n          <value>\\r\\n            <State>\\r\\n              <option name=\\\"CUSTOM_BOOLEAN_PROPERTIES\\\">\\r\\n                <map>\\r\\n                  <entry key=\\\"Show.Git.Branches\\\" value=\\\"true\\\" />\\r\\n                </map>\\r\\n              </option>\\r\\n              <option name=\\\"FILTERS\\\">\\r\\n                <map>\\r\\n                  <entry key=\\\"branch\\\">\\r\\n                    <value>\\r\\n                      <list>\\r\\n                        <option value=\\\"cpp_update\\\" />\\r\\n                      </list>\\r\\n                    </value>\\r\\n                  </entry>\\r\\n                </map>\\r\\n              </option>\\r\\n            </State>\\r\\n          </value>\\r\\n        </entry>\\r\\n      </map>\\r\\n    </option>\\r\\n  </component>\\r\\n  <component name=\\\"VcsManagerConfiguration\\\">\\r\\n    <ignored-roots>\\r\\n      <path value=\\\"$PROJECT_DIR$\\\" />\\r\\n    </ignored-roots>\\r\\n    <MESSAGE value=\\\"25.4.21&#10;在ctrl加入了无感速度闭环，但是还没与有感进行解耦，能零速启动但是会抖动(需要使用高频注入启动)。&#10;还有就是速度貌似无法达到和有感一样，有待探究\\\" />\\r\\n    <MESSAGE value=\\\"25.6.20&#10;加入了电阻参数辨识，电流还增加了反馈解耦但是还没进行封装\\\" />\\r\\n    <MESSAGE value=\\\"25.6.25&#10;增加了高频注入算法双环,但是整体还需要进一步封装\\\" />\\r\\n    <MESSAGE value=\\\"25.6.27&#10;去除了一些比较杂碎的东西并增加了注释&#10;另外测试了巴特沃斯滤波器，发现貌似有一些bug导致无法正常使用。可能跟数据类型或者启动的时刻有关，temp一直出现inf超长度\\\" />\\r\\n    <MESSAGE value=\\\"25.7.11&#10;由于手头上没有电机，所以这个版本后仓库不再更新，以做保留\\\" />\\r\\n    <MESSAGE value=\\\"25.11.30&#10;使用2代板完成非线性磁链观测器的demo，同步模式下已验证可用\\\" />\\r\\n    <MESSAGE value=\\\"25.12.4&#10;完成非线性磁链基本测试，12V状态下可以速度闭环到7000rpm。电流环能快速收敛和正反转\\\" />\\r\\n    <MESSAGE value=\\\"25.12.8&#10;1) 添加了无感速度控制的输入限度&#10;2) 初步添加了fdcan作为普通can使用的驱动,具体的收发还需要进一步验证\\\" />\\r\\n    <MESSAGE value=\\\"25.12.31&#10;增加IIC的cbue配置，软件改为新驱动板的适配\\\" />\\r\\n    <MESSAGE value=\\\"26.1.15&#10;1.更改了ADC的采样时钟频率&#10;2.更改高频注入的方式，有原先的高频脉振-1 +1 变化改为+1 -&gt; 0 -&gt; -1 -&gt; 0。角度计算函数改为正负电流都采集完毕后才计算。&#10;3.更改了注入函数，和高频sign符号更改的地方&#10;4.目前角度是能解算出来，但是貌似急性不对，给Vq总是反转。还有待解决\\\" />\\r\\n    <MESSAGE value=\\\"26.1.17&#10;1.更新高频注入的角度计算，以及注入频率。现已可以实现纯高频注入速度环闭环&#10;2.去掉SMO算法中一些无用的东西，去除了foc和adc结构体中的端电压相关变量\\\" />\\r\\n    <MESSAGE value=\\\"26.2.2&#10;(1)将高频注入的PI参数独立出来&#10;(2)增加了非线性磁链速度环的速度滤波，10000目标值，稳态在9650rpm左右\\\" />\\r\\n    <MESSAGE value=\\\"26.2.4&#10;（1）初步增加了电流基类\\\" />\\r\\n    <MESSAGE value=\\\"26.2.5&#10;（1）增加了电流采样的基类和在线采样类、低侧三电阻采样类\\\" />\\r\\n    <MESSAGE value=\\\"26.2.5&#10;（1）增加了SVPWM类\\\" />\\r\\n    <MESSAGE value=\\\"26.2.12&#10;(1)增加了编码器类,包含了ABI和AS5047P,但是还没彻底完善,可以简单进行读值操作&#10;(2)使用电流采样类和SVPWM类对原有结构进行部分替换,删减了foc_ctrl中一些没用的东西\\\" />\\r\\n    <MESSAGE value=\\\"26.2.12&#10;补充提交\\\" />\\r\\n    <MESSAGE value=\\\"26.2.25&#10;(1)对filter滤波器进行cpp替换&#10;(2)构建pid类,包括增量式和位置式.还有普通的PI控制类&#10;(3)通过继承PI控制类,构建了PLL速度观测器&#10;(4)对编码器encoder类进行进一步的补充,目前Hall还未实现&#10;(5)把初始化的结构体都集中到了一个大的结构体中&#10;(6)初步构建了观测器的算法类\\\" />\\r\\n    <MESSAGE value=\\\"26.2.26&#10;(1)完成了非线性磁链的cpp替代&#10;(2)初步新增了高频注入观测器的类，还未验证\\\" />\\r\\n    <MESSAGE value=\\\"26.2.26&#10;补充\\\" />\\r\\n    <MESSAGE value=\\\"26.3.1&#10;高频出入cpp重构验证通过\\\" />\\r\\n    <MESSAGE value=\\\"26.3.14&#10;（1）增加了滑膜观测的类&#10;（2）增加了OLED类&#10;（3）增加了Key类\\\" />\\r\\n    <MESSAGE value=\\\"26.3.16&#10;将电流环速度环等PID进行替换\\\" />\\r\\n    <MESSAGE value=\\\